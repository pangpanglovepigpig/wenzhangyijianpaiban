# 同一个“排版文章”按钮：Vercel 和已配置远程接口的 GitHub Pages 都设为 true。
VITE_ENABLE_AI_DRAFT=true
# Vercel 同源部署留空；GitHub Pages 指向正式站 API。
# VITE_AI_DRAFT_ENDPOINT=https://wenzhangyijianpaiban.vercel.app/api/generate-draft
# EdgeOne/Vercel 等根路径部署用 /，GitHub Pages 用 /wenzhangyijianpaiban/。
VITE_BASE_PATH=/

DEEPSEEK_API_KEY=
# 默认使用 deepseek-v4-flash，生成更快；如需更高质量可改为 deepseek-v4-pro。
# DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek 最长等待 55000 毫秒；超时、限流或格式异常会提示失败，保留此前结果。
# DEEPSEEK_TIMEOUT_MS=55000
