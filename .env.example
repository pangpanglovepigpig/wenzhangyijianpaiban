# Vercel 完整版设为 true；GitHub Pages 等纯静态部署必须设为 false。
VITE_ENABLE_AI_DRAFT=true
# EdgeOne/Vercel 等根路径部署用 /，GitHub Pages 用 /wenzhangyijianpaiban/。
VITE_BASE_PATH=/

DEEPSEEK_API_KEY=
# 默认使用 deepseek-v4-flash，生成更快；如需更高质量可改为 deepseek-v4-pro。
# DEEPSEEK_MODEL=deepseek-v4-flash
# DeepSeek 最长等待 25000 毫秒；超时、限流或格式异常会自动返回完整本地排版。
# DEEPSEEK_TIMEOUT_MS=25000
